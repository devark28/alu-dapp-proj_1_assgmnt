{
  "name": "alu-logo-registry",
  "version": "1.0.0",
  "description": "Registers the ALU logo as an ERC-721 NFT and splits its ownership into ERC-20 shares",
  "license": "MIT",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "hash": "node scripts/hash-logo.js alu-logo.png",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.2",
    "hardhat": "2.29.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  }
}
